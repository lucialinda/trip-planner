rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        // Keep this list in sync with src/lib/admin.ts.
        && request.auth.uid in [
          "xdiqN6R92NbFXjf2zB8y0xdTB0Ky",
          "PTKwn2IQngeI1PFhuwx2t6Uv5iu2"
        ];
    }

    function isTripMember(tripId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
    }

    function isTripMemberAfter(tripId) {
      return signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/trips/$(tripId)).data.memberUids;
    }

    function isOwnPlaceCreate() {
      return signedIn()
        && request.resource.data.addedByUid == request.auth.uid;
    }

    function isOwnPlaceVote() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes'])
        && request.resource.data.likes is map
        && request.resource.data.dislikes is map
        && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.dislikes.diff(resource.data.dislikes).affectedKeys().hasOnly([request.auth.uid]);
    }

    function canAccessThreadData(tripId, thread) {
      return isTripMember(tripId)
        && thread.deleted == false
        && (
          thread.visibility == 'public'
          || (
            thread.visibility == 'private'
            && thread.createdByUid == request.auth.uid
          )
        );
    }

    match /userProfiles/{uid} {
      function hasValidUserProfileShape() {
        return request.resource.data.keys().hasOnly([
            'name',
            'photoURL',
            'settlementAccountBank',
            'settlementAccountNumber',
            'settlementAccountHolder'
          ])
          && (!('name' in request.resource.data) || request.resource.data.name is string)
          && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string || request.resource.data.photoURL == null)
          && (!('settlementAccountBank' in request.resource.data) || request.resource.data.settlementAccountBank is string)
          && (!('settlementAccountNumber' in request.resource.data) || request.resource.data.settlementAccountNumber is string)
          && (!('settlementAccountHolder' in request.resource.data) || request.resource.data.settlementAccountHolder is string);
      }

      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && hasValidUserProfileShape();
      allow delete: if false;
    }

    match /trips/{tripId} {
      function hasTripMembershipFields() {
        return 'memberUids' in resource.data
          && 'members' in resource.data;
      }

      function isJoiningSelf() {
        return signedIn()
          && hasTripMembershipFields()
          && !(request.auth.uid in resource.data.memberUids)
          && request.auth.uid in request.resource.data.memberUids
          && exists(/databases/$(database)/documents/tripCodes/$(resource.data.code))
          && get(/databases/$(database)/documents/tripCodes/$(resource.data.code)).data.tripId == tripId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          && request.resource.data.members is map;
      }

      function canChangeHeroPhoto() {
        return isAdmin()
          && hasTripMembershipFields()
          && request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heroPhotoURL']);
      }

      function canSyncOwnMemberName() {
        return signedIn()
          && hasTripMembershipFields()
          && request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members is map;
      }

      function canAdminManageTrip() {
        return isAdmin()
          && hasTripMembershipFields()
          && request.auth.uid in resource.data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'startDate',
            'endDate',
            'code',
            'members',
            'memberUids',
            'heroPhotoURL'
          ]);
      }

      allow read: if signedIn()
        && request.auth.uid in resource.data.memberUids;

      allow create: if isAdmin()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.members[request.auth.uid] is string
        && (
          !('createdByUid' in request.resource.data)
          || request.resource.data.createdByUid == request.auth.uid
        );

      allow update: if isJoiningSelf()
        || canSyncOwnMemberName()
        || canChangeHeroPhoto()
        || canAdminManageTrip();

      allow delete: if isAdmin()
        && request.auth.uid in resource.data.memberUids;

      match /places/{placeId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId)
          && isOwnPlaceCreate()
          && request.resource.data.keys().hasOnly(['name', 'date', 'time', 'startTime', 'endTime', 'placeUrl', 'note', 'addedBy', 'addedByUid', 'likes', 'dislikes', 'createdAt']);
        allow update: if isTripMember(tripId)
          && (
            (
              request.resource.data.addedByUid == resource.data.addedByUid
              && request.resource.data.addedBy == resource.data.addedBy
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'name', 'time', 'startTime', 'endTime', 'placeUrl', 'note'])
            )
            || isOwnPlaceVote()
          );
        allow delete: if isTripMember(tripId);
      }

      match /votes/{voteId} {
        allow read, create, update: if isTripMember(tripId);
        allow delete: if false;
      }

      match /expenses/{expenseId} {
        function hasValidExpenseShape() {
          return request.resource.data.keys().hasOnly([
              'category',
              'description',
              'paidByUid',
              'paidBy',
              'paymentCurrency',
              'foreignAmount',
              'exchangeRate',
              'exchangeRateStatus',
              'estimatedKrwAmount',
              'finalizedKrwAmount',
              'cardSettlementConfirmed',
              'localCurrency',
              'localAmount',
              'rate',
              'krwAmount',
              'confirmedRate',
              'confirmedKrwAmount',
              'status',
              'paidAt',
              'participants',
              'settlementRequestId',
              'settlementRequestedAt',
              'settledAt',
              'createdByUid',
              'createdBy',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.category in ['food', 'cafe', 'transit', 'lodging', 'activity', 'shopping', 'etc']
            && request.resource.data.description is string
            && request.resource.data.paidByUid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids
            && request.resource.data.paidBy is string
            && request.resource.data.paymentCurrency is string
            && request.resource.data.foreignAmount is number
            && request.resource.data.foreignAmount > 0
            && request.resource.data.exchangeRate is number
            && request.resource.data.exchangeRate > 0
            && request.resource.data.localCurrency is string
            && request.resource.data.localAmount is number
            && request.resource.data.localAmount > 0
            && request.resource.data.rate is number
            && request.resource.data.rate > 0
            && request.resource.data.krwAmount is number
            && request.resource.data.krwAmount > 0
            && request.resource.data.status in ['tentative', 'requested', 'confirmed']
            && request.resource.data.paidAt is timestamp
            && request.resource.data.participants is map
            && request.resource.data.participants.keys().size() > 0
            && request.resource.data.participants.keys().hasOnly(get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids)
            && (
              !('createdByUid' in request.resource.data)
              || (
                request.resource.data.createdByUid is string
                && request.resource.data.createdByUid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids
              )
            )
            && (
              !('createdBy' in request.resource.data)
              || request.resource.data.createdBy is string
            )
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && (
              !('confirmedRate' in request.resource.data)
              || (
                request.resource.data.confirmedRate is number
                && request.resource.data.confirmedRate > 0
              )
            )
            && (
              !('confirmedKrwAmount' in request.resource.data)
              || (
                request.resource.data.confirmedKrwAmount is number
                && request.resource.data.confirmedKrwAmount > 0
              )
            )
            && (
              !('exchangeRateStatus' in request.resource.data)
              || request.resource.data.exchangeRateStatus == null
              || request.resource.data.exchangeRateStatus in ['estimated', 'finalized']
            )
            && (
              !('estimatedKrwAmount' in request.resource.data)
              || request.resource.data.estimatedKrwAmount == null
              || (
                request.resource.data.estimatedKrwAmount is number
                && request.resource.data.estimatedKrwAmount > 0
              )
            )
            && (
              !('finalizedKrwAmount' in request.resource.data)
              || request.resource.data.finalizedKrwAmount == null
              || (
                request.resource.data.finalizedKrwAmount is number
                && request.resource.data.finalizedKrwAmount > 0
              )
            )
            && (
              !('cardSettlementConfirmed' in request.resource.data)
              || request.resource.data.cardSettlementConfirmed == null
              || request.resource.data.cardSettlementConfirmed is bool
            )
            && (
              !('settlementRequestId' in request.resource.data)
              || request.resource.data.settlementRequestId is string
            )
            && (
              !('settlementRequestedAt' in request.resource.data)
              || request.resource.data.settlementRequestedAt is timestamp
            )
            && (
              !('settledAt' in request.resource.data)
              || request.resource.data.settledAt is timestamp
            );
        }

        function isOwnExpenseCreate() {
          return request.resource.data.createdByUid == request.auth.uid;
        }

        function preservesExpenseAuditFields() {
          return (!('createdByUid' in resource.data) || request.resource.data.createdByUid == resource.data.createdByUid)
            && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        function isDirectExpenseUpdate() {
          return isTripMember(tripId)
            && resource.data.status != 'requested'
            && request.resource.data.status in ['tentative', 'confirmed']
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'settlementRequestId',
              'settlementRequestedAt',
              'settledAt'
            ]);
        }

        function isRequestingExpenseSettlement() {
          return resource.data.status == 'tentative'
            && request.resource.data.status == 'requested'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'settlementRequestId',
              'settlementRequestedAt',
              'updatedAt'
            ])
            && request.resource.data.settlementRequestId is string
            && request.resource.data.settlementRequestedAt is timestamp
            && existsAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(request.resource.data.settlementRequestId))
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(request.resource.data.settlementRequestId)).data.status == 'requested'
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(request.resource.data.settlementRequestId)).data.requestedByUid == request.auth.uid
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(request.resource.data.settlementRequestId)).data.expenseIds.hasAny([expenseId]);
        }

        function isCompletingRequestedExpense() {
          return resource.data.status == 'requested'
            && request.resource.data.status == 'confirmed'
            && resource.data.settlementRequestId is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'settledAt', 'updatedAt'])
            && request.resource.data.settledAt is timestamp
            && existsAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.settlementRequestId))
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.settlementRequestId)).data.status == 'completed'
            && (
              isAdmin()
              || getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.settlementRequestId)).data.completedByUid == request.auth.uid
            );
        }

        function isCancellingRequestedExpense() {
          return resource.data.status == 'requested'
            && request.resource.data.status == 'tentative'
            && resource.data.settlementRequestId is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'settlementRequestId',
              'settlementRequestedAt',
              'updatedAt'
            ])
            && !('settlementRequestId' in request.resource.data)
            && !('settlementRequestedAt' in request.resource.data)
            && existsAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.settlementRequestId))
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.settlementRequestId)).data.status == 'cancelled'
            && (
              isAdmin()
              || getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.settlementRequestId)).data.cancelledByUid == request.auth.uid
            );
        }

        allow read: if isTripMember(tripId) || isAdmin();
        allow create: if isAdmin()
          || (isTripMember(tripId)
          && hasValidExpenseShape()
          && isOwnExpenseCreate());
        allow update: if isAdmin()
          || (isTripMember(tripId)
          && hasValidExpenseShape()
          && preservesExpenseAuditFields()
          && (
            isDirectExpenseUpdate()
            || isRequestingExpenseSettlement()
            || isCompletingRequestedExpense()
            || isCancellingRequestedExpense()
          ));
        allow delete: if isAdmin()
          || isTripMember(tripId);
      }

      match /settlementAdjustments/{adjustmentId} {
        function hasValidSettlementAdjustmentShape() {
          return request.resource.data.keys().hasOnly([
              'type',
              'fromMemberId',
              'toMemberId',
              'amount',
              'currency',
              'memo',
              'status',
              'createdBy',
              'createdAt',
              'updatedAt',
              'appliedToSettlementRequestId'
            ])
            && request.resource.data.type == 'direct_transfer'
            && request.resource.data.fromMemberId in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids
            && request.resource.data.toMemberId in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids
            && request.resource.data.fromMemberId != request.resource.data.toMemberId
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.currency == 'KRW'
            && request.resource.data.status in ['active', 'applied', 'voided']
            && request.resource.data.createdBy in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && (
              !('memo' in request.resource.data)
              || request.resource.data.memo is string
            )
            && (
              request.resource.data.appliedToSettlementRequestId == null
              || request.resource.data.appliedToSettlementRequestId is string
            );
        }

        function preservesSettlementAdjustmentIdentityFields() {
          return request.resource.data.type == resource.data.type
            && request.resource.data.currency == resource.data.currency
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        allow read: if isTripMember(tripId) || isAdmin();
        allow create: if isTripMember(tripId)
          && hasValidSettlementAdjustmentShape()
          && request.resource.data.status == 'active'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.appliedToSettlementRequestId == null;
        allow update: if (isTripMember(tripId) || isAdmin())
          && hasValidSettlementAdjustmentShape()
          && preservesSettlementAdjustmentIdentityFields()
          && (
            (
              resource.data.status == 'active'
              && (
                (
                  request.resource.data.status == 'active'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'fromMemberId',
                    'toMemberId',
                    'amount',
                    'memo',
                    'updatedAt'
                  ])
                  && (resource.data.createdBy == request.auth.uid || isAdmin())
                )
                || (
                  request.resource.data.status == 'voided'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                  && request.resource.data.appliedToSettlementRequestId == resource.data.appliedToSettlementRequestId
                  && (resource.data.createdBy == request.auth.uid || isAdmin())
                )
                || (
                  request.resource.data.status == 'applied'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'status',
                    'appliedToSettlementRequestId',
                    'updatedAt'
                  ])
                  && request.resource.data.appliedToSettlementRequestId is string
                  && existsAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(request.resource.data.appliedToSettlementRequestId))
                  && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(request.resource.data.appliedToSettlementRequestId)).data.status == 'requested'
                  && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(request.resource.data.appliedToSettlementRequestId)).data.requestedByUid == request.auth.uid
                  && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(request.resource.data.appliedToSettlementRequestId)).data.adjustmentIds.hasAny([adjustmentId])
                )
              )
            )
            || (
              resource.data.status == 'applied'
              && request.resource.data.status == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'appliedToSettlementRequestId',
                'updatedAt'
              ])
              && resource.data.appliedToSettlementRequestId is string
              && request.resource.data.appliedToSettlementRequestId == null
              && existsAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.appliedToSettlementRequestId))
              && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.appliedToSettlementRequestId)).data.status == 'cancelled'
              && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.appliedToSettlementRequestId)).data.cancelledByUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/trips/$(tripId)/settlementRequests/$(resource.data.appliedToSettlementRequestId)).data.adjustmentIds.hasAny([adjustmentId])
            )
          );
        allow delete: if false;
      }

      match /settlementRequests/{requestId} {
        function hasValidSettlementRequestShape() {
          return request.resource.data.keys().hasOnly([
              'tripId',
              'title',
              'status',
              'requestedByUid',
              'requestedByName',
              'requestedAt',
              'completedAt',
              'completedByUid',
              'completedByName',
              'cancelledAt',
              'cancelledByUid',
              'cancelledByName',
              'cancelReason',
              'expenseIds',
              'expenseSnapshots',
              'adjustmentIds',
              'adjustmentSnapshots',
              'transfers',
              'totalExpenseAmount',
              'transferTotal',
              'shareUrl',
              'shareMessage',
              'createdAt',
              'updatedAt'
            ])
            && request.resource.data.tripId == tripId
            && request.resource.data.title is string
            && request.resource.data.status in ['requested', 'completed', 'cancelled']
            && request.resource.data.requestedByUid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids
            && request.resource.data.requestedByName is string
            && request.resource.data.requestedAt is timestamp
            && request.resource.data.expenseIds is list
            && request.resource.data.expenseIds.size() > 0
            && request.resource.data.expenseIds.size() <= 50
            && request.resource.data.expenseSnapshots is list
            && request.resource.data.expenseSnapshots.size() == request.resource.data.expenseIds.size()
            && (!('adjustmentIds' in request.resource.data) || request.resource.data.adjustmentIds is list)
            && (!('adjustmentIds' in request.resource.data) || request.resource.data.adjustmentIds.size() <= 50)
            && (!('adjustmentSnapshots' in request.resource.data) || request.resource.data.adjustmentSnapshots is list)
            && (
              !('adjustmentIds' in request.resource.data)
              || !('adjustmentSnapshots' in request.resource.data)
              || request.resource.data.adjustmentSnapshots.size() == request.resource.data.adjustmentIds.size()
            )
            && request.resource.data.transfers is list
            && request.resource.data.transfers.size() <= 50
            && request.resource.data.totalExpenseAmount is number
            && request.resource.data.totalExpenseAmount >= 0
            && request.resource.data.transferTotal is number
            && request.resource.data.transferTotal >= 0
            && request.resource.data.shareUrl is string
            && request.resource.data.createdAt is timestamp
            && request.resource.data.updatedAt is timestamp
            && (!('shareMessage' in request.resource.data) || request.resource.data.shareMessage is string)
            && (!('completedAt' in request.resource.data) || request.resource.data.completedAt is timestamp)
            && (!('completedByUid' in request.resource.data) || request.resource.data.completedByUid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids)
            && (!('completedByName' in request.resource.data) || request.resource.data.completedByName is string)
            && (!('cancelledAt' in request.resource.data) || request.resource.data.cancelledAt is timestamp)
            && (!('cancelledByUid' in request.resource.data) || request.resource.data.cancelledByUid in get(/databases/$(database)/documents/trips/$(tripId)).data.memberUids)
            && (!('cancelledByName' in request.resource.data) || request.resource.data.cancelledByName is string)
            && (!('cancelReason' in request.resource.data) || request.resource.data.cancelReason is string);
        }

        function preservesSettlementRequestBaseFields() {
          return request.resource.data.tripId == resource.data.tripId
            && request.resource.data.title == resource.data.title
            && request.resource.data.requestedByUid == resource.data.requestedByUid
            && request.resource.data.requestedByName == resource.data.requestedByName
            && request.resource.data.requestedAt == resource.data.requestedAt
            && request.resource.data.expenseIds == resource.data.expenseIds
            && request.resource.data.expenseSnapshots == resource.data.expenseSnapshots
            && (!('adjustmentIds' in resource.data) || request.resource.data.adjustmentIds == resource.data.adjustmentIds)
            && (!('adjustmentSnapshots' in resource.data) || request.resource.data.adjustmentSnapshots == resource.data.adjustmentSnapshots)
            && request.resource.data.transfers == resource.data.transfers
            && request.resource.data.totalExpenseAmount == resource.data.totalExpenseAmount
            && request.resource.data.transferTotal == resource.data.transferTotal
            && request.resource.data.shareUrl == resource.data.shareUrl
            && (!('shareMessage' in resource.data) || request.resource.data.shareMessage == resource.data.shareMessage)
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        function firstExpenseIsLinkedAfter() {
          return request.resource.data.expenseIds.size() > 0
            && existsAfter(/databases/$(database)/documents/trips/$(tripId)/expenses/$(request.resource.data.expenseIds[0]))
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/expenses/$(request.resource.data.expenseIds[0])).data.status == 'requested'
            && getAfter(/databases/$(database)/documents/trips/$(tripId)/expenses/$(request.resource.data.expenseIds[0])).data.settlementRequestId == requestId;
        }

        allow read: if isTripMember(tripId) || isAdmin();
        allow create: if isTripMember(tripId)
          && hasValidSettlementRequestShape()
          && request.resource.data.status == 'requested'
          && request.resource.data.requestedByUid == request.auth.uid
          && firstExpenseIsLinkedAfter()
          && !('completedAt' in request.resource.data)
          && !('cancelledAt' in request.resource.data);
        allow update: if (isTripMember(tripId) || isAdmin())
          && hasValidSettlementRequestShape()
          && preservesSettlementRequestBaseFields()
          && resource.data.status == 'requested'
          && (
            (
              request.resource.data.status == 'completed'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'completedAt',
                'completedByUid',
                'completedByName',
                'updatedAt'
              ])
              && request.resource.data.completedByUid == request.auth.uid
              && (resource.data.requestedByUid == request.auth.uid || isAdmin())
            )
            || (
              request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'cancelledAt',
                'cancelledByUid',
                'cancelledByName',
                'updatedAt'
              ])
              && request.resource.data.cancelledByUid == request.auth.uid
              && (resource.data.requestedByUid == request.auth.uid || isAdmin())
            )
          );
        allow delete: if false;
      }

      match /threads/{threadId} {
        allow read: if canAccessThreadData(tripId, resource.data);
        allow create: if isTripMember(tripId)
          && request.resource.data.keys().hasOnly(['title', 'visibility', 'createdByUid', 'createdByName', 'createdAt', 'updatedAt', 'deleted'])
          && request.resource.data.title is string
          && request.resource.data.visibility in ['public', 'private']
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByName is string
          && request.resource.data.deleted == false;
        allow update: if isTripMember(tripId)
          && (
            (
              resource.data.createdByUid == request.auth.uid
              && request.resource.data.createdByUid == resource.data.createdByUid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'updatedAt', 'deleted'])
              && request.resource.data.title is string
            )
            || (
              canAccessThreadData(tripId, resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])
            )
          );
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if canAccessThreadData(
            tripId,
            get(/databases/$(database)/documents/trips/$(tripId)/threads/$(threadId)).data
          );
          allow create: if canAccessThreadData(
            tripId,
            get(/databases/$(database)/documents/trips/$(tripId)/threads/$(threadId)).data
          )
            && request.resource.data.keys().hasOnly(['text', 'uid', 'displayName', 'photoURL', 'createdAt'])
            && request.resource.data.text is string
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.displayName is string;
          allow update, delete: if false;
        }

        match /reads/{uid} {
          allow read: if uid == request.auth.uid
            && canAccessThreadData(
              tripId,
              get(/databases/$(database)/documents/trips/$(tripId)/threads/$(threadId)).data
            );
          allow create, update: if uid == request.auth.uid
            && canAccessThreadData(
              tripId,
              get(/databases/$(database)/documents/trips/$(tripId)/threads/$(threadId)).data
            )
            && request.resource.data.keys().hasOnly(['uid', 'readAt'])
            && request.resource.data.uid == request.auth.uid;
          allow delete: if false;
        }
      }

      match /messages/{messageId} {
        allow read: if isTripMember(tripId);
        allow create: if isTripMember(tripId)
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /tripCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['tripId', 'createdAt'])
        && request.resource.data.tripId is string
        && existsAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId))
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.code == code
        && isTripMemberAfter(request.resource.data.tripId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
